# Edge proxy runtime config. Copy to /opt/caddy/caddy.env on the host (root-only,
# mode 600) and fill in. Never commit the filled-in file.
#
# Two kinds of value live here:
#   1. the proxy's own settings (the ACME contact address);
#   2. values referenced by TENANT site snippets in /opt/caddy-sites — snippets
#      stay templated ({$DOMAIN}) instead of hardcoding host-specific values,
#      and credentials never touch a repo.

# ACME (Let's Encrypt) contact address for certificate notices.
CADDY_ACME_EMAIL=admin@example.com

# --- tenant-supplied values referenced by site snippets ---

# Application domains used by that application's snippet.
DOMAIN=example.com
STAGE_DOMAIN=stage.example.com

# Basic-auth gate for the monitoring dashboard snippet. Generate the hash with
# `docker exec caddy caddy hash-password` — store the HASH, never the password.
UPTIME_KUMA_USERNAME=operator
UPTIME_KUMA_PASSWORD_HASH='$2a$14$replace-with-generated-bcrypt-hash'
