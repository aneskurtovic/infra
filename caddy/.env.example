# Edge proxy runtime config. Copy to /opt/caddy/caddy.env on the host (root-only,
# mode 600) and fill in. Never commit the filled-in file.
#
# Two kinds of value live here:
#   1. the proxy's own settings (the ACME contact address);
#   2. values referenced by TENANT site snippets in /opt/caddy-sites — snippets
#      stay templated ({$DOMAIN}) instead of hardcoding host-specific values,
#      and credentials never touch a repo.

# ACME (Let's Encrypt) contact address for certificate notices.
CADDY_ACME_EMAIL=admin@example.com

# --- tenant-supplied values referenced by site snippets ---

# Application domains used by that application's snippet.
DOMAIN=example.com
STAGE_DOMAIN=stage.example.com

# Basic-auth gate for the monitoring dashboard snippet. Generate the hash with:
#
#   docker exec -it caddy caddy hash-password
#
# `-it` is REQUIRED: hash-password prompts on stdin, and `docker exec` without a
# TTY hands it a closed one, so it reads EOF and dies with a bare `Error: EOF`
# that says nothing about a missing terminal. Store the HASH, never the password.
UPTIME_KUMA_USERNAME=operator
UPTIME_KUMA_PASSWORD_HASH='$2a$14$replace-with-generated-bcrypt-hash'

# UNUSED as of 2026-08-10 — kept because they are harmless and deleting them
# invites someone to "restore" the gate that these once fed.
#
# Grafana had an outer Caddy basic_auth gate; it was REMOVED because it broke
# Grafana's login (the browser keeps sending `Authorization: Basic …`, which
# outranks Grafana's session cookie and 401s a correctly logged-in user). Grafana
# is now protected by its own login alone — see caddy/logs.aneskurtovic.caddy for
# the full reasoning, and do not re-add a gate here without reading it.
#
# Safe to delete these two lines. Note the asymmetry with UPTIME_KUMA_* above,
# which IS still live: only Grafana consumes the Authorization header itself.
GRAFANA_USERNAME=operator
GRAFANA_PASSWORD_HASH='$2a$14$replace-with-generated-bcrypt-hash'
