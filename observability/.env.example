# Observability stack runtime config. Copy to
# /opt/observability/observability.env on the host (root-only, mode 600) and
# fill in. Never commit the filled-in file.
#
# Only Grafana needs values — Loki has no auth and Alloy is configured entirely
# by alloy/config.alloy. Every variable here is referenced with a `:?required`
# guard in docker-compose.yml, so a missing one fails the `up` loudly instead of
# starting a half-configured dashboard.
#
#   install -d -m 755 /opt/observability
#   install -m 600 /dev/null /opt/observability/observability.env

# Public URL Grafana believes it is served at. MUST match the hostname in
# caddy/logs.aneskurtovic.caddy, including the scheme and trailing slash —
# otherwise Grafana generates links and redirects pointing at the container.
GRAFANA_ROOT_URL=https://logs.example.com/

# Bootstrap admin account, applied on FIRST START only. After that the
# credentials live in the grafana-data volume and changing these does nothing;
# rotate the password in the Grafana UI instead.
#
# Note this is the inner gate. The outer one is Caddy basic_auth, whose bcrypt
# hash lives in /opt/caddy/caddy.env — a different file with a different value.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
