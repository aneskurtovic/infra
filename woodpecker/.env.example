# Non-secret runtime config for the Woodpecker server.
#
# Copy to /opt/ci/.env on the host and fill in. The REAL secrets do NOT go here —
# they live in two separate root-only files (see BOOTSTRAP.md):
#   /opt/ci/server-oauth.env  ->  WOODPECKER_GITHUB_SECRET
#   /opt/ci/agent.env         ->  WOODPECKER_AGENT_SECRET
#
# Never commit the filled-in .env (.gitignore already blocks it).

# Public hostname Woodpecker serves on. Must match the Caddy site and the
# GitHub OAuth App callback (https://<CI_DOMAIN>/authorize).
CI_DOMAIN=ci.example.com

# GitHub OAuth App client id. Not a credential, but kept host-side for tidiness.
WOODPECKER_GITHUB_CLIENT=<oauth-client-id>

# Your GitHub login — the instance admin.
WOODPECKER_ADMIN=<github-login>

# Only repositories owned by these GitHub owner(s) may be enabled. Comma-separated.
WOODPECKER_REPO_OWNERS=<github-login>

# Steady state: true. Flip to false ONLY during the one-time agent registration,
# then set back to true once the agent token is stored.
WOODPECKER_DISABLE_USER_AGENT_REGISTRATION=true

# Address the server publishes gRPC (:9000) on, for agents that do not run on
# this box. This is the ONLY port reachable from outside the Docker networks,
# and an agent secret is all that stands behind it, so it is bound to the host's
# Tailscale address — not a public interface.
#
# Get it with `tailscale ip -4`. It is stable for the life of the tailnet node.
# MUST NOT be 0.0.0.0, a public IP, or empty.
CI_AGENT_GRPC_BIND=100.x.y.z
