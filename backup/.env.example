# Platform backup config. Copy to /opt/backups/backup.env on the host (root-only,
# mode 600) and fill in. Never commit the filled-in file.
#
# `backup/install.sh` copies this file into place if none exists, so the box
# starts from a version of this documentation rather than a blank file.
#
# Read by two things that parse it differently: systemd's `EnvironmentFile=` and
# the scripts' own `. backup.env`. Keep every value on one line, and quote
# anything containing a space — the two parsers agree about simple values and
# disagree about clever ones.

# --- where the snapshots go ------------------------------------------------
#
# Any restic backend works; the platform deliberately does not care which. The
# only requirements are that it is OFF THIS BOX and not the same disk failure
# domain as the thing it protects.
#
# Hetzner Storage Box over SFTP (add the box's public key to the Storage Box
# first, then confirm the host key once by hand — restic gives no prompt and a
# first-run host-key mismatch looks like a generic connection failure):
#RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/platform
#
# Any S3-compatible bucket (Backblaze B2, Wasabi, Cloudflare R2, MinIO). Use a
# credential scoped to this one bucket, with no delete permission if the backend
# offers object lock — a compromised box should not be able to erase its own
# history.
#RESTIC_REPOSITORY=s3:https://s3.example.com/platform-backups
#AWS_ACCESS_KEY_ID=REPLACE
#AWS_SECRET_ACCESS_KEY=REPLACE
RESTIC_REPOSITORY=sftp:REPLACE@REPLACE:/platform

# The file holding the repository password. NOT the password itself: an
# environment value is readable from /proc for the life of the process, and this
# file is also copied into every systemd unit's environment.
#
# THE SAME PASSWORD MUST EXIST OFF THIS BOX, in a password manager. restic has
# no recovery path — a repository whose password died with the disk is a
# repository of random bytes. Neither this file nor the password file is ever
# included in a snapshot, for the same reason you do not keep the only key
# inside the safe.
RESTIC_PASSWORD_FILE=/opt/backups/restic-password

# --- retention -------------------------------------------------------------
#
# BACKLOG.md P1 asks for at least seven daily generations, against a tenant
# script that keeps exactly one. Fourteen dailies means a corruption discovered
# on the second Monday still has a clean copy; the weeklies and monthlies cost
# almost nothing on a deduplicating store and cover the slow kind of damage
# nobody notices for a month.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6

# --- the tenant hand-off contract ------------------------------------------
#
# Hours before a tenant's newest hand-off file is reported as stale. 30 rather
# than 24 so a nightly producer that drifts by an hour, or a run delayed by
# RandomizedDelaySec, does not cry wolf every morning. Warning only — one
# tenant's broken cron must never stop the platform's own backup.
BACKUP_HANDOFF_MAX_AGE_HOURS=30

# --- rarely changed --------------------------------------------------------
#
# The restic "host" label. Deliberately NOT $(hostname): retention groups
# snapshots by host, so a rebuilt box under a new name would start a second
# group, leaving the old one unpruned and the new one with no history. The
# identity that matters is the platform, not the machine it currently runs on.
#BACKUP_HOST=platform
#
# Fraction of the repository's data the weekly check re-reads. Structure is
# always verified in full; this is what detects bit rot at the storage provider,
# and it is the part that costs egress.
#BACKUP_CHECK_READ_DATA_SUBSET=10%
#
# The throwaway container used to copy volume contents out. Pinned, like every
# other image in this repo.
#BACKUP_HELPER_IMAGE=alpine:3.22
